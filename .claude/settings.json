{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/list-sidebar-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/list-sidebar-guard.sh\"",
            "timeout": 300,
            "statusMessage": "성공의 열쇠/알아차림 리스트 점검 중..."
          }
        ]
      }
    ]
  }
}
